# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SiteForge runtime locks / temp writes
**/.run.lock
**/*.tmp

# Ephemeral timestamped knowledge export dumps (keep latest.json tracked)
knowledge/exports/entities-*.jsonl
knowledge/exports/evidence-*.jsonl
knowledge/exports/relationships-*.jsonl
knowledge/exports/snapshot-*.json

# Local review-workflow test scratch project (if created)
/projects/review-fixture-co/
/knowledge/normalization/indexes/status-review-fixture-co.json
/knowledge/normalization/mappings/review-fixture-co.json
/knowledge/normalization/reviews/review-fixture-co-log.json
